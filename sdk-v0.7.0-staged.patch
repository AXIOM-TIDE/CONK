 export function isReady(): boolean {
   return !!PACKAGES.CONK
 }
+
+// ── v14: Set on-chain synapse references for a cast ──────────────────────────
+// Declares explicit Cast→Cast references via dynamic field (weight=2.0 each).
+// Only callable by the author (vessel cap holder). Idempotent — replaces previous refs.
+// Brain indexer picks up CastReferenced events and writes explicit synapse edges.
+//
+// @param castId     - Cast object ID to annotate
+// @param refs       - Array of Cast object IDs (as addresses) that this cast references
+// @param vesselId   - Vessel object ID (must match cast.vessel_id)
+// @param vesselCapId - VesselCap object ID (proves authorship)
+// @param clockId    - Sui clock (default: 0x6)
+export async function setReferences(opts: {
+  castId:      string
+  refs:        string[]
+  vesselId:    string
+  vesselCapId: string
+  clockId?:    string
+}): Promise<string> {
+  const session = getSession()
+  if (!session) throw new Error('No session')
+  if (opts.refs.length === 0) throw new Error('refs must be non-empty')
+
+  const { Transaction } = await import('@mysten/sui/transactions')
+  const tx = new Transaction()
+  const clock = opts.clockId ?? CLOCK
+
+  tx.moveCall({
+    target:    `${PACKAGE}::cast::set_references`,
+    arguments: [
+      tx.object(opts.castId),      // &mut Cast
+      tx.object(opts.vesselId),    // &Vessel
+      tx.object(opts.vesselCapId), // &VesselCap
+      tx.pure.vector('address', opts.refs),  // refs: vector<address>
+      tx.object(clock),            // &Clock
+    ],
+  })
+
+  tx.setSender(session.address)
+  const result = await executeTx(tx, session.address)
+  return result.digest
+}
